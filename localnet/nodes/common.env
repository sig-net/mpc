# Settings shared by every node in the local MPC cluster.
#
# Per-node secrets and the port each node listens on live alongside this file in node<N>.env.
# See localnet/README.md.
#
# Endpoints are deliberately absent. The entrypoint exports MPC_NEAR_RPC, MPC_REDIS_URL, the
# two Solana URLs and RUST_LOG after sourcing this file, so that a consumer can repoint them
# with container environment variables. Setting one here as well would give it two sources
# that drift.

# MPC_ENV doubles as an environment label and a feature switch. "integration-tests" is the
# only value that starts the NEAR indexer, which is what picks up signature requests made
# through the MPC contract.
MPC_ENV=integration-tests
# Required, but only ever used to address Google Secret Manager. The localnet keeps key
# shares on disk instead, so this is never dereferenced.
MPC_GCP_PROJECT_ID=mpc-localnet
MPC_DISABLE_GCP_LOGS=true
MPC_OPENTELEMETRY_LEVEL=off

MPC_CONTRACT_ID=mpc.test.near

# Key shares are baked in at /data/keyshare-<account id>, which is where DiskNodeStorage
# looks. Without this the node keeps its share in memory and loses it on restart, which
# would force the network into a resharing it cannot complete.
MPC_SK_SHARE_LOCAL_PATH=/data/keyshare

MPC_SOL_PROGRAM_ADDRESS=FR5pWwinRBn35GNhg7bsvw8Q13kRept2pm561DwZCQzT
MPC_SOL_TOTAL_TIMEOUT=120

# Peer liveness and request polling.
MPC_MESH_PING_INTERVAL=1000
MPC_INDEXER_RUNNING_THRESHOLD=300
# Raised from the 1000 ms default. Every node, both chains and Redis share one host here, so
# peer calls see more jitter than they would spread across a real network.
MPC_NODE_TIMEOUT=3000
MPC_NODE_STATE_TIMEOUT=3000

RUST_BACKTRACE=1
