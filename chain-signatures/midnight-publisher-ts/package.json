{
  "name": "midnight-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Midnight respond publisher over a line-delimited stdio protocol: builds a serialized ledger Intent by running a respond circuit, and submits one by proving, balancing and posting it from the funding wallet. Mechanism only, never an authority.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "midnight-publisher": "dist/main.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:initial-state": "tsx devtools/gen-initial-state.ts"
  },
  "dependencies": {
    "@effect/platform-node": "0.107.0",
    "@midnight-ntwrk/compact-js": "2.5.5-rc.6",
    "@midnight-ntwrk/compact-js-node": "2.5.5-rc.6",
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@sig-net/midnight-contract": "0.15.0",
    "@sig-net/midnight-contract-deploy": "0.15.0",
    "effect": "3.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
