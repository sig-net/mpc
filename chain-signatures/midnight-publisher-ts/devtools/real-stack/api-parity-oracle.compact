  return calculateSignetAttestationDigest<62>(requestId, blockHeight, kind, data);
}

export pure circuit digest63(
  requestId: RequestId, blockHeight: Uint<64>, kind: OutputKind, data: Bytes<63>
): Bytes<32> {
  return calculateSignetAttestationDigest<63>(requestId, blockHeight, kind, data);
}

export pure circuit verify0(
  data: Bytes<0>, response: RespondBidirectionalEvent, responseKey: Secp256k1Point
): Boolean {
  return verifyRespondBidirectionalEvent<0>(data, response, responseKey);
}
