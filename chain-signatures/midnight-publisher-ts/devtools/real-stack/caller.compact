// Test-only real caller for the Rust-owned integration stack. Its structure is the
// minimal subset of sig-net/midnight-integration's v0.20.0-rc.1 test caller.
pragma language_version >= 0.25;

import CompactStandardLibrary;
import "@sig-net/midnight/src/Signet";

struct BoolResponse {
  success: Boolean;
}

// The declaration order is protocol-visible. The request map is field 3 and the
// notification below names that exact path.
export ledger requestNonce: Counter;
export ledger mpcResponseKey: Secp256k1Point;
sealed ledger signetSigner: SignetSigner;
export ledger requests: SignBidirectionalEventMap<EvmType2TxParams<1, 0, 0>, 64, 64>;
sealed ledger deployer: Bytes<32>;
export ledger initialised: Counter;

witness deployerSecretKey(): Bytes<32>;

export pure circuit deployerCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "signet-caller:deployer:"), sk]);
}

constructor(initialDeployerCommitment: Bytes<32>, signetContract: SignetSigner) {
  deployer = disclose(initialDeployerCommitment);
  signetSigner = disclose(signetContract);
}

export circuit initialise(responseKey: Secp256k1Point): [] {
  assert(initialised == 0, "Already initialised");
  assert(deployerCommitment(deployerSecretKey()) == deployer, "Not the deployer");
  initialised.increment(1);
  mpcResponseKey = disclose(responseKey);
}

export circuit submitIsEvenRequest(
  evmNonce: Uint<64>,
  keyVersion: Uint<8>,
  to: Bytes<20>,
  argWord: Bytes<32>,
  outputSchema: Bytes<64>,
  responseSchema: Bytes<64>
): [] {
  const calldata = EvmCalldata<1> {
    selector: Bytes [0x2a, 0x2e, 0x13, 0x20],
    noWords: 1 as Uint<16>,
    words: [argWord]
  };
  const txParams = EvmType2TxParams<1, 0, 0> {
    chainId: 31337 as Uint<64>,
    nonce: evmNonce,
    maxPriorityFeePerGas: 1000000000 as Uint<128>,
    maxFeePerGas: 30000000000 as Uint<128>,
    gasLimit: 100000 as Uint<64>,
    to: to,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<1>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };
  const nonce = requestNonce as Uint<64>;
  const request = constructSignBidirectionalEvent<EvmType2TxParams<1, 0, 0>, 64, 64>(
    kernel.self(),
    nonce,
    keyVersion,
    pad(32, "caller-path"),
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    pad(32, "eip155:1"),
    outputSchema,
    responseSchema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<1, 0, 0>, 64, 64>(request));

  assert(!requests.member(requestId), "Request already exists");
  requestNonce.increment(1);
  requests.insert(requestId, disclose(request));

  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      1 as Uint<8>,
      [3, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Test-only impersonation: notify the central Signet contract naming another contract's request.
// The MPC must drop it because this contract, not `victim`, is the direct caller.
export circuit notifyAs(victim: ContractAddress, requestId: RequestId): [] {
  signetSigner.signBidirectional(
    disclose(requestId),
    constructSignBidirectionalEventNotificationV1(
      disclose(victim),
      1 as Uint<8>,
      [3, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

circuit consumeResponse<#N>(
  requestId: RequestId,
  response: RespondBidirectionalEvent,
  serializedOutput: Bytes<N>
): [] {
  const disclosedRequestId = disclose(requestId);
  assert(initialised != 0, "Not initialised");
  assert(
    verifyRespondBidirectionalEvent<N>(
      disclosedRequestId, serializedOutput, disclose(response), mpcResponseKey
    ),
    "Invalid attestation signature"
  );
  assert(requests.member(disclosedRequestId), "Request not found");
  requests.remove(disclosedRequestId);
}

export circuit verifyResponse(
  requestId: RequestId,
  response: RespondBidirectionalEvent,
  serializedOutput: Bytes<1>
): [] {
  consumeResponse<1>(requestId, response, serializedOutput);
  assert(deserialize<BoolResponse, 1>(serializedOutput).success, "Foreign call reported failure");
}

export circuit verifyResponse5(
  requestId: RequestId,
  response: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>
): [] {
  consumeResponse<5>(requestId, response, serializedOutput);
  assert(serializedOutput == Bytes [0xde, 0xad, 0xbe, 0xef, 1], "Expected execution failure");
}

export circuit verifyResponse8(
  requestId: RequestId,
  response: RespondBidirectionalEvent,
  serializedOutput: Bytes<8>
): [] {
  consumeResponse<8>(requestId, response, serializedOutput);
}

export circuit verifyResponse32(
  requestId: RequestId,
  response: RespondBidirectionalEvent,
  serializedOutput: Bytes<32>
): [] {
  consumeResponse<32>(requestId, response, serializedOutput);
}
