{
  "name": "midnight-devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Midnight test tooling for the Rust MPC node: deploys and drives the real-stack fixture contracts, and generates the cross-language fixtures the Rust tests read. Never shipped.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "compile:real-stack-caller": "node devtools/real-stack/compile.mjs caller",
    "compile:real-stack-vault": "node devtools/real-stack/compile.mjs erc20-vault",
    "typecheck:real-stack": "tsc --noEmit -p devtools/real-stack/tsconfig.json",
    "gen:initial-state": "tsx devtools/gen-initial-state.ts",
    "gen:midnight-respond-vectors": "tsx devtools/generate-midnight-respond-vectors.ts",
    "compile:api-parity-oracle": "compact compile +0.36.0 --skip-zk --compact-path node_modules devtools/real-stack/api-parity-oracle.compact devtools/real-stack/managed/api-parity-oracle",
    "pregen:api-parity-vectors": "npm run compile:api-parity-oracle",
    "gen:api-parity-vectors": "node --import tsx devtools/real-stack/generate-api-parity-vectors.ts",
    "postcompile:real-stack-caller": "npm run compile:api-parity-oracle"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@sig-net/midnight-contract": "0.26.0-rc.7",
    "@sig-net/midnight-contract-deploy": "0.26.0-rc.7",
    "@sig-net/midnight-responder": "0.26.0-rc.7"
  },
  "devDependencies": {
    "@effect/platform-node": "0.108.4",
    "@eslint/js": "^10.0.1",
    "@midnight-ntwrk/midnight-js": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0",
    "@sig-net/midnight": "0.26.0-rc.7",
    "@sig-net/midnight-respond-oracle": "npm:@sig-net/midnight@0.24.0-rc.10",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "6.17.0",
    "prettier": "3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.1",
    "@midnightntwrk/onchain-runtime-v4": "4.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@sig-net/midnight@0.26.0-rc.7": {
      "@sig-net/midnight-serde": "0.26.0-rc.7"
    }
  }
}
